# Clarify Agent 配置示例
# 复制为 .env 后填写自己的密钥；此文件不包含真实密钥、口令或专属工作区地址。

# 1. 主 Agent：DeepSeek
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro

# 2. 知识库向量接口：SiliconFlow
EMBEDDING_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 3. 评测裁判：独立的 Qwen 服务，仅评测时使用
# BASE_URL 为占位地址，必须替换为自己的完整 API 地址，同时填写匹配的密钥。
JUDGE_MODEL=qwen-plus-2025-12-01
JUDGE_API_KEY=
JUDGE_BASE_URL=https://your-qwen-endpoint.example.com/v1

# 4. 模拟用户：按 Agent 追问披露需求，仅评测时使用
# 可以与裁判使用同一服务地址；密钥仍需自行填写，不会自动复用 JUDGE_API_KEY。
SIM_USER_MODEL=qwen3.5-flash
SIM_USER_API_KEY=
SIM_USER_BASE_URL=https://your-qwen-endpoint.example.com/v1

# JUDGE_* / SIM_USER_* 各字段留空时，分别回退到对应的 OPENAI_* 配置。
# 若全部使用主模型，请将该组的 MODEL、API_KEY、BASE_URL 三项一起留空或注释。
# 若使用独立服务，请成组填写，避免混用不同服务的地址、模型和密钥。

# 5. MCP 网页抓取
# 默认不允许访问内网 IP；本地代理使用 Fake-IP 等确有需要时，自行改为 true。
FETCH_ALLOW_PRIVATE_IPS=false

# 6. 评测工作区：留空默认使用当前项目的 result/，无需填写本机绝对路径。
EVAL_HOME=
# 可选：固定随机种子。不要写成 EVAL_SEED=；评测脚本未设置时默认 20261117。
# 显式设置也会影响 Web/CLI 的模型请求，发送 seed 和 temperature=0。
# EVAL_SEED=20261117

# 7. 网页公网部署：本机运行时，地址与口令保持为空。
# Render 自动提供 RENDER_EXTERNAL_URL，不必额外填写 WEB_PUBLIC_URL。
# 自有域名填写完整 HTTPS 网址；公网访问口令需 12～256 个字符。
WEB_PUBLIC_URL=
WEB_ACCESS_PASSWORD=
WEB_MAX_CONNECTIONS=2
WEB_SESSION_SECONDS=43200
